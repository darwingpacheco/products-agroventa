POSTGRES_DB=productsdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

SPRING_PROFILES_ACTIVE=docker
R2DBC_URL=r2dbc:postgresql://postgres:5432/productsdb
DB_USERNAME=postgres
DB_PASSWORD=postgres
FLYWAY_JDBC_URL=jdbc:postgresql://postgres:5432/productsdb
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters
JWT_EXPIRATION_SECONDS=3600
JWT_ISSUER=agroventa-products-service

AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=replace-with-products-bucket
AWS_S3_PUBLIC_BASE_URL=https://replace-with-products-bucket.s3.us-east-1.amazonaws.com
AWS_S3_PREFIX=products
AWS_S3_MAX_FILE_SIZE=5242880
AWS_S3_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_SESSION_TOKEN=

